{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "certificate.schema.json",
  "title": "Certificate wording and settings",
  "type": "object",
  "required": ["title", "subtitle", "certifies", "statement", "validity_note", "microtext", "signatories", "verify"],
  "additionalProperties": false,
  "properties": {
    "notice": {"type": ["string", "null"], "description": "Proof-of-concept notice; blank once the feature is adopted."},
    "orientation": {"enum": ["landscape", "portrait"]},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "certifies": {"type": "string"},
    "statement": {"type": "string", "description": "May use {level} and {criteria}."},
    "validity_note": {"type": "string"},
    "microtext": {"type": "string"},
    "seal": {"type": ["string", "null"], "description": "Seal image, relative to tool/."},
    "signatories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "designation", "office"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string"},
          "designation": {"type": "string"},
          "office": {"type": "string"}
        }
      }
    },
    "verify": {
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": {
        "url": {"type": ["string", "null"]},
        "note": {"type": "string"}
      }
    }
  }
}
