{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "System Profile form",
  "type": "object",
  "required": ["title", "sections"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string"},
    "intro": {"type": ["string", "null"]},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "fields"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "note": {"type": ["string", "null"]},
          "team": {
            "type": "object",
            "required": ["agencies", "roles", "sign_off"],
            "additionalProperties": false,
            "properties": {
              "help": {"type": "string"},
              "agencies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["key", "label", "sign_as"],
                  "additionalProperties": false,
                  "properties": {
                    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Stores the name; <key>_agency and <key>_designation store the rest. Do not rename."},
                    "label": {"type": "string"},
                    "required": {"type": "boolean"},
                    "sign_as": {"type": "string", "description": "First line of the role cell in the sign-off, e.g. Validated by."},
                    "help": {"type": "string"}
                  }
                }
              },
              "sign_off": {"type": "array", "items": {"type": "string"}, "description": "Order of the sign-off rows (role keys)."}
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key", "label"],
              "additionalProperties": false,
              "properties": {
                "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Storage key in saved evaluations. Do not rename."},
                "label": {"type": "string"},
                "help": {"type": ["string", "null"]},
                "type": {"enum": ["text", "date", "long"]},
                "options": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "required": {"type": "string", "description": "Short note shown next to the label."},
                "placeholder": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
